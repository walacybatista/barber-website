# Conexão com o Postgres (docker compose local: porta 5433).
DATABASE_URL=postgres://barber:barber@localhost:5433/barber

# URL pública do site (usada em canonical, sitemap e Open Graph).
SITE_URL=http://localhost:4321

# Número de WhatsApp (DDI+DDD+número, só dígitos). Valor fictício.
PUBLIC_WHATSAPP_NUMBER=5500000000000

# Banco SEPARADO para testes de integração (o nome deve terminar em _test; criar: docker compose exec -T db psql -U barber -c "create database barber_test").
TEST_DATABASE_URL=postgres://barber:barber@localhost:5433/barber_test

# false se usar pooler em transaction mode (Supabase/Neon): desliga prepared statements.
# DATABASE_PREPARE=true  (padrão; use false com pooler em transaction mode)

# Servidor Node em produção (adaptador standalone): interface e porta de escuta.
# HOST=0.0.0.0
# PORT=4321

# Em produção (Supabase/Neon) use TLS: acrescente ?sslmode=require em DATABASE_URL.
# Ex.: DATABASE_URL=postgres://user:senha@host:5432/db?sslmode=require

# Banco SEPARADO para e2e (Playwright); o global-setup faz TRUNCATE + migrar + seed. Nome deve terminar em _e2e (criar: docker compose exec -T db psql -U barber -c "create database barber_e2e").
E2E_DATABASE_URL=postgres://barber:barber@localhost:5433/barber_e2e

# ADR-009: true = site fictício não indexável (padrão). false apenas para cliente real.
PUBLIC_NOINDEX=true

# Produção: domínio(s) público(s) aceitos para Host/X-Forwarded-Host (Astro security.allowedDomains).
# Lista separada por vírgula, um host por item: cobrevelho.example,www.cobrevelho.example
# Avaliado NO BUILD: defina no ambiente do build, não só em runtime.
# OBRIGATÓRIO atrás de proxy reverso: sem ele o Astro ignora X-Forwarded-For e o rate limit por IP
# colapsa no IP do proxy. O proxy DEVE SOBRESCREVER (não anexar) X-Forwarded-For e X-Forwarded-Host
# com o valor real do cliente; senão o cliente forja o IP e burla o rate limit.
# ALLOWED_DOMAIN=cobrevelho.example

---
interface Props {
  /** id do h2 (usado em aria-labelledby da <section>). */
  id: string;
  eyebrow: string;
  title: string;
  subtitle?: string;
}
const { id, eyebrow, title, subtitle } = Astro.props;
---

<div class="mb-8 lg:mb-12">
  <p class="text-primary text-xs font-medium tracking-[0.08em] uppercase">{eyebrow}</p>
  <h2 id={id} class="text-h2 mt-2 leading-[var(--text-h2--line-height)] font-semibold">
    {title}
  </h2>
  <div class="bg-primary mt-4 h-0.5 w-12" aria-hidden="true"></div>
  {subtitle && <p class="text-text-muted mt-4 max-w-[65ch]">{subtitle}</p>}
</div>

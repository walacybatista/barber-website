---
import { business } from '@/data/business';
import Container from './Container.astro';
import ExternalLink from './ExternalLink.astro';
import { formatPhoneDisplay, whatsappHref, whatsappNumber } from '@/lib/whatsapp';
import Icon from './Icon.astro';
---

<footer class="bg-surface border-border-subtle border-t pb-24">
  <Container class="grid gap-8 py-12 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-xl font-bold">{business.shortName}</p>
      <p class="text-text-muted mt-2">{business.tagline}</p>
    </div>
    <div>
      <h2 class="text-text-muted text-xs font-medium tracking-[0.08em] uppercase">Contato</h2>
      <address class="mt-3 not-italic">
        {business.address.street}
        <br />
        {business.address.neighborhood}
        <br />
        {business.address.city}/{business.address.region} · CEP {business.address.postalCode}
        <br />
        <span class="text-text-muted">Tel./WhatsApp: {formatPhoneDisplay(whatsappNumber())}</span>
      </address>
    </div>
    <div>
      <h2 class="text-text-muted text-xs font-medium tracking-[0.08em] uppercase">Redes</h2>
      <ul class="mt-3 space-y-2">
        <li class="text-text-muted flex items-center gap-2">
          <Icon name="instagram" />
          <span>Instagram {business.instagramHandle} (perfil fictício)</span>
        </li>
        <li>
          <ExternalLink
            href={whatsappHref()}
            class="border-border-strong hover:bg-surface-2 flex h-11 w-11 items-center justify-center rounded-md border"
          >
            <Icon name="whatsapp" />
            <span class="sr-only">WhatsApp</span>
          </ExternalLink>
        </li>
      </ul>
    </div>
    <nav aria-label="Rodapé">
      <h2 class="text-text-muted text-xs font-medium tracking-[0.08em] uppercase">Links</h2>
      <ul class="mt-3 space-y-1">
        <li>
          <a href="/agendar" class="prose-link inline-flex min-h-11 items-center">
            Agendar
          </a>
        </li>
        <li>
          <a href="/privacidade" class="prose-link inline-flex min-h-11 items-center">
            Privacidade
          </a>
        </li>
      </ul>
    </nav>
  </Container>
  <div class="border-border-subtle border-t">
    <Container class="text-text-muted py-6 text-sm">
      <p>
        <strong class="text-text font-semibold">Barbearia fictícia — projeto de portfólio.</strong>{' '}
        Nome, endereço, telefone, preços e fotos são inventados.
      </p>
      <p class="mt-1">© 2026 {business.shortName} (fictícia)</p>
    </Container>
  </div>
</footer>

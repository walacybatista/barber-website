---
import { Image } from 'astro:assets';
import type { GalleryItem } from '@/data/business';
import { getAsset } from '@/lib/images';

interface Props {
  items: GalleryItem[];
}
const { items } = Astro.props;
---

{items.length === 0 ? (
  <p class="text-text-muted">Fotos em breve.</p>
) : (
  <ul class="grid grid-cols-2 gap-2 md:grid-cols-3 lg:grid-cols-4">
    {items.map((item) => (
      <li>
        <figure class="bg-surface-2 aspect-square overflow-hidden rounded-md">
          <Image
            src={getAsset(item.file)}
            alt={item.alt}
            width={600}
            height={600}
            widths={[320, 480]}
            sizes="(min-width: 1024px) 262px, (min-width: 768px) 33vw, 50vw"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </figure>
      </li>
    ))}
  </ul>
)}

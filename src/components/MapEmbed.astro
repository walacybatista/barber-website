---
import Button from './Button.astro';
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';

interface Props {
  lat: number;
  lng: number;
  /** Endereço em texto (fallback sempre visível). */
  address: string;
  title: string;
}
const { lat, lng, address, title } = Astro.props;
const embedUrl = `https://maps.google.com/maps?q=${lat},${lng}&z=16&output=embed`;
const openUrl = `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;
---

<div class="min-w-0">
  <!-- Sem JS a facade não funciona: o bloco some e fica só o link "Abrir no Google Maps". -->
  <div
    class="border-border-subtle bg-surface-2 relative hidden min-h-60 overflow-hidden rounded-md border js:block md:aspect-video lg:aspect-[21/9]"
    data-map
    data-src={embedUrl}
    data-title={title}
  >
    <div
      class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-4 text-center"
      data-map-facade
    >
      <Icon name="pin" class="text-primary h-8 w-8" />
      <p class="text-text-muted max-w-[32ch] text-sm">{address}</p>
      <Button variant="primary" data-map-load>
        Carregar mapa
      </Button>
      <p class="text-text-muted text-xs">O mapa do Google só é carregado quando você clica.</p>
    </div>
  </div>
  <p class="mt-3">
    <ExternalLink href={openUrl} class="prose-link">
      Abrir no Google Maps
    </ExternalLink>
  </p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-map]');
  const load = root?.querySelector<HTMLButtonElement>('[data-map-load]');
  load?.addEventListener('click', () => {
    if (!root) return;
    const iframe = document.createElement('iframe');
    iframe.src = root.dataset.src ?? '';
    iframe.title = root.dataset.title ?? 'Mapa';
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    iframe.className = 'absolute inset-0 h-full w-full border-0';
    // O botão clicado sai do DOM; sem mover o foco ele cairia no <body> (WCAG 2.4.3).
    iframe.tabIndex = -1;
    root.querySelector('[data-map-facade]')?.remove();
    root.appendChild(iframe);
    iframe.focus();
  });
</script>

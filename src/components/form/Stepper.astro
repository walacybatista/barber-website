---
export type StepperStep = { label: string; href?: string };

interface Props {
  steps: StepperStep[];
  /** Etapa atual, base 1. */
  current: number;
}
const { steps, current } = Astro.props;
const total = steps.length;
const currentLabel = steps[current - 1]?.label ?? '';
// CSP (ADR-011 S4): sem style="" inline. Larguras como classes estáticas (Tailwind precisa vê-las
// literais); chave = "etapa/total". Cobre fluxos de 2 a 6 etapas (o /agendar tem 5).
const progressWidth: Record<string, string> = {
  '1/2': 'w-1/2',
  '2/2': 'w-full',
  '1/3': 'w-1/3',
  '2/3': 'w-2/3',
  '3/3': 'w-full',
  '1/4': 'w-1/4',
  '2/4': 'w-2/4',
  '3/4': 'w-3/4',
  '4/4': 'w-full',
  '1/5': 'w-1/5',
  '2/5': 'w-2/5',
  '3/5': 'w-3/5',
  '4/5': 'w-4/5',
  '5/5': 'w-full',
  '1/6': 'w-1/6',
  '2/6': 'w-2/6',
  '3/6': 'w-3/6',
  '4/6': 'w-4/6',
  '5/6': 'w-5/6',
  '6/6': 'w-full',
};
// Fallback w-0 (não w-full): combinação não mapeada fica visivelmente errada em vez de parecer concluída.
const barWidth = progressWidth[`${current}/${total}`] ?? 'w-0';
---

<nav aria-label="Etapas do agendamento" class="mb-8">
  <!-- Mobile: texto compacto + barra de progresso -->
  <div class="md:hidden">
    <p class="text-text-muted text-sm">
      Etapa {current} de {total} — <span class="text-text font-medium">{currentLabel}</span>
    </p>
    <div
      class="bg-surface-2 mt-2 h-1 w-full overflow-hidden rounded-full"
      role="progressbar"
      aria-label="Progresso do agendamento"
      aria-valuemin={1}
      aria-valuemax={total}
      aria-valuenow={current}
      aria-valuetext={`Etapa ${current} de ${total}`}
    >
      <div class={`bg-primary h-full ${barWidth}`}></div>
    </div>
  </div>

  <!-- Desktop: todas as etapas -->
  <ol class="hidden items-center gap-3 md:flex">
    {steps.map((s, i) => {
      const n = i + 1;
      const done = n < current;
      const isCurrent = n === current;
      const circle = isCurrent
        ? 'bg-primary border-primary text-on-primary'
        : done
          ? 'border-primary text-primary'
          : 'border-border-strong text-text-muted';
      return (
        <li class="flex items-center gap-3" aria-current={isCurrent ? 'step' : undefined}>
          {done && s.href ? (
            <a href={s.href} class="flex min-h-11 items-center gap-2 hover:underline">
              <span
                class={`inline-flex h-8 w-8 items-center justify-center rounded-full border text-sm font-semibold ${circle}`}
              >
                <span aria-hidden="true">✓</span>
              </span>
              <span>
                {s.label}
                <span class="sr-only"> (concluída, voltar a esta etapa)</span>
              </span>
            </a>
          ) : (
            <span class="flex min-h-11 items-center gap-2">
              <span
                class={`inline-flex h-8 w-8 items-center justify-center rounded-full border text-sm font-semibold ${circle}`}
                aria-hidden="true"
              >
                {n}
              </span>
              <span class={isCurrent ? 'text-text' : 'text-text-muted'}>{s.label}</span>
            </span>
          )}
          {n < total && <span class="bg-border-subtle h-px w-6" aria-hidden="true" />}
        </li>
      );
    })}
  </ol>
</nav>

---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFloatingButton from '@/components/WhatsAppFloatingButton.astro';
import { business } from '@/data/business';
import { serializeJsonLd } from '@/lib/seo';
import { isNoindex, siteUrl } from '@/lib/site';

interface Props {
  title: string;
  description?: string;
  /** Imagem Open Graph (caminho absoluto no site). */
  ogImage?: string;
  /** Objeto JSON-LD a embutir (ex.: BarberShop na home). */
  jsonLd?: object;
  noindex?: boolean;
}

const {
  title,
  description = business.description,
  ogImage = '/og.png',
  jsonLd,
  noindex,
} = Astro.props;

// ADR-009: noindex por padrão (PUBLIC_NOINDEX); páginas podem forçar noindex via prop.
const blockIndexing = noindex || isNoindex();
const site = siteUrl(Astro.site);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage, site).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#14110f" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {blockIndexing && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/fraunces-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Cobre Velho Barbearia (fictícia): corte clássico, hora marcada."
    />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-screen">
    <a
      href="#conteudo"
      class="bg-primary text-on-primary sr-only z-50 rounded-md px-4 py-3 font-semibold focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
      data-inert-on-menu
    >
      Ir para o conteúdo
    </a>
    <Header />
    <main id="conteudo" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloatingButton />
  </body>
</html>

---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import BarberCard from '@/components/BarberCard.astro';
import GalleryGrid from '@/components/GalleryGrid.astro';
import HoursTable from '@/components/HoursTable.astro';
import MapEmbed from '@/components/MapEmbed.astro';
import Icon from '@/components/Icon.astro';
import Container from '@/components/Container.astro';
import { business } from '@/data/business';
import { getAsset } from '@/lib/images';
import { buildBarberShopJsonLd } from '@/lib/seo';
import { siteUrl } from '@/lib/site';
import { whatsappHref, whatsappNumber } from '@/lib/whatsapp';

const site = siteUrl(Astro.site);
const jsonLd = buildBarberShopJsonLd(business, site.href, {
  image: new URL('/og.png', site).href,
  whatsapp: whatsappNumber(),
});

const hero = getAsset(business.images.hero.file);
const about = getAsset(business.images.about.file);
const { address } = business;
const fullAddress = `${address.street} — ${address.neighborhood}, ${address.city}/${address.region}`;

const section = 'py-16 lg:py-24';
---

<BaseLayout title={`${business.name} — ${business.tagline}`} jsonLd={jsonLd}>
  <section aria-labelledby="hero-titulo" class="border-border-subtle border-b">
    <Container class="grid items-center gap-8 pb-12 lg:grid-cols-2 lg:gap-12 lg:py-16">
      <div class="order-2 lg:order-1">
        <p class="text-primary text-xs font-medium tracking-[0.08em] uppercase">
          Barbearia fictícia em {address.city}
        </p>
        <h1
          id="hero-titulo"
          class="text-display mt-3 leading-[var(--text-display--line-height)] font-bold"
        >
          {business.tagline}
        </h1>
        <p class="text-lg text-text-muted mt-4 max-w-[52ch] leading-[var(--text-lg--line-height)]">
          Tesoura afiada, navalha quente e hora marcada. Escolha o serviço e o barbeiro e reserve em
          menos de um minuto.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/agendar" class="w-full sm:w-auto">
            Agendar horário
          </Button>
          <Button href="#servicos" variant="secondary" class="w-full sm:w-auto">
            Ver serviços
          </Button>
        </div>
      </div>
      <div class="bg-surface-2 order-1 -mx-4 aspect-[16/10] overflow-hidden md:-mx-6 lg:order-2 lg:mx-0 lg:aspect-[4/5] lg:rounded-md">
        <Image
          src={hero}
          alt={business.images.hero.alt}
          width={800}
          height={1000}
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 560px, 100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
    </Container>
  </section>

  <section id="sobre" aria-labelledby="sobre-titulo" class={section}>
    <Container class="grid items-center gap-10 lg:grid-cols-12">
      <div class="min-w-0 lg:col-span-7">
        <SectionHeading id="sobre-titulo" eyebrow="Sobre" title="Tradição no corte, hora marcada" />
        <div class="max-w-[65ch] space-y-4">
          {business.about.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
        <dl class="mt-8 grid grid-cols-3 gap-4">
          {business.about.highlights.map((h) => (
            <div class="flex flex-col">
              <dt class="text-text-muted order-2 text-sm">{h.label}</dt>
              <dd class="font-display text-primary text-h3 font-semibold">{h.value}</dd>
            </div>
          ))}
        </dl>
        <p class="text-text-muted mt-4 text-sm">{business.about.footnote}</p>
      </div>
      <div class="bg-surface-2 aspect-square overflow-hidden rounded-md lg:col-span-5">
        <Image
          src={about}
          alt={business.images.about.alt}
          width={800}
          height={800}
          widths={[480, 800]}
          sizes="(min-width: 1024px) 440px, 100vw"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
    </Container>
  </section>

  <section id="servicos" aria-labelledby="servicos-titulo" class={`${section} bg-surface/40`}>
    <Container>
      <SectionHeading
        id="servicos-titulo"
        eyebrow="Serviços"
        title="Serviços e preços"
        subtitle="Valores fictícios, apenas para demonstração."
      />
      {business.services.length === 0 ? (
        <p class="text-text-muted" role="status">
          Serviços em atualização. Volte em breve.
        </p>
      ) : (
        <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 lg:gap-6">
          {business.services.map((service) => (
            <li>
              <ServiceCard service={service} />
            </li>
          ))}
        </ul>
      )}
    </Container>
  </section>

  <section id="barbeiros" aria-labelledby="barbeiros-titulo" class={section}>
    <Container>
      <SectionHeading
        id="barbeiros-titulo"
        eyebrow="Equipe"
        title="Barbeiros"
        subtitle="Nomes e retratos ilustrativos, inventados para este projeto."
      />
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {business.barbers.map((barber) => (
          <li>
            <BarberCard barber={barber} />
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <section id="galeria" aria-labelledby="galeria-titulo" class={`${section} bg-surface/40`}>
    <Container>
      <SectionHeading
        id="galeria-titulo"
        eyebrow="Galeria"
        title="Galeria"
        subtitle="Fotos ilustrativas."
      />
      <GalleryGrid items={business.images.gallery} />
    </Container>
  </section>

  <Container class={`${section} grid grid-cols-1 gap-12 lg:grid-cols-12`}>
    <section id="horarios" aria-labelledby="horarios-titulo" class="min-w-0 lg:col-span-5">
      <SectionHeading
        id="horarios-titulo"
        eyebrow="Horários"
        title="Horário de funcionamento"
        subtitle="Horários fictícios."
      />
      <HoursTable hours={business.openingHours} />
    </section>

    <section id="localizacao" aria-labelledby="localizacao-titulo" class="lg:col-span-7">
      <SectionHeading
        id="localizacao-titulo"
        eyebrow="Localização"
        title="Onde estamos"
        subtitle="Endereço fictício."
      />
      <address class="mb-4 not-italic">
        <Icon name="pin" class="text-primary mr-1 inline h-5 w-5 align-text-bottom" />
        {fullAddress}
      </address>
      <MapEmbed
        lat={business.geo.lat}
        lng={business.geo.lng}
        address={fullAddress}
        title={`Mapa da localização da ${business.name} (endereço fictício)`}
      />
    </section>
  </Container>

  <section id="contato" aria-labelledby="contato-titulo" class={`${section} bg-surface/40`}>
    <Container>
      <SectionHeading
        id="contato-titulo"
        eyebrow="Contato"
        title="Redes sociais e contato"
        subtitle="Canais fictícios, só para demonstração."
      />
      <ul class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <li>
          <Button href={whatsappHref()} variant="secondary" external class="w-full sm:w-auto">
            <Icon name="whatsapp" /> Falar no WhatsApp
          </Button>
        </li>
        <li>
          <p class="text-text-muted flex min-h-11 items-center gap-2 px-1">
            <Icon name="instagram" /> Instagram {business.instagramHandle} (perfil fictício)
          </p>
        </li>
        <li>
          <Button href={`mailto:${business.email}`} variant="secondary" class="w-full sm:w-auto">
            <Icon name="mail" /> {business.email}
          </Button>
        </li>
      </ul>
    </Container>
  </section>
</BaseLayout>

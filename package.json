{
  "name": "barber-website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "test:integration": "vitest run --project integration",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "db:anonymize": "node --experimental-strip-types scripts/anonymize.ts",
    "admin:create": "node --experimental-strip-types scripts/create-admin.ts",
    "validate": "npm run check && tsc --noEmit && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.0.0",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
